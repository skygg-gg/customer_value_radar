      <column caption='Purchase Orders' datatype='integer' name='[Calculation_3099831135113217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [has_product_sale] THEN [invoice]&#10;    END&#10;)' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_3099831135842306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gross_product_sales_value])&#10;/&#10;COUNTD(&#10;    IF [has_product_sale] THEN [invoice]&#10;    END&#10;)' />
      </column>
      <column caption='Identified Customers' datatype='integer' name='[Calculation_3099831136522243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [has_product_sale] THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='Cancellation Invoices' datatype='integer' name='[Calculation_3099831173804041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [has_product_cancellation] THEN [invoice]&#10;    END&#10;)' />
      </column>
